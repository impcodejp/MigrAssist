{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MigrAssist",
  "version": "0.1.0",
  "identifier": "MigrAssist.impcode.jp",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "MigrAssist",
        "width": 1080,
        "height": 820,
        "minWidth": 900,
        "minHeight": 700,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
"bundle": {
    "active": true,
    "targets": ["nsis"],
    "resources": {
      "../docs": "docs"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "languages": ["Japanese"],
        "installMode": "perMachine"
      }
    }
  }
}
